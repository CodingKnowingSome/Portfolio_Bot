import discord
from discord import app_commands
from discord.ext import commands
import logging
from cryptography.hazmat.primitives.asymmetric import rsa
from cryptography.hazmat.primitives import serialization
import sqlite3
from datetime import datetime

logger = logging.getLogger(__name__)


class Keys(commands.Cog):
    def __init__(self, bot):
        self.bot = bot

    @app_commands.command(name="keys", description="Generate/view your keys.")
    async def keys(self, interaction: discord.Interaction):
        await interaction.response.defer(ephemeral=True)
        private_key = rsa.generate_private_key(public_exponent=65537, key_size=2048)
        public_key = private_key.public_key()
        public_pem = public_key.public_bytes(encoding=serialization.Encoding.PEM,
                                             format=serialization.PublicFormat.SubjectPublicKeyInfo).decode()
        private_pem = private_key.private_bytes(encoding=serialization.Encoding.PEM,
                                                format=serialization.PrivateFormat.PKCS8,
                                                encryption_algorithm=serialization.NoEncryption()).decode()
        with sqlite3.connect("data/keys.db") as conn:
            c = conn.cursor()
            c.execute("INSERT INTO keys (public, user_id) VALUES (?, ?) ON CONFLICT (user_id) DO UPDATE SET public=excluded.public",
                      (public_pem, interaction.user.id))
            conn.commit()
        priv_embed = discord.Embed(
            title="Private Key",
            description="The following is your private key for decrypting message. Do not share it with anyone. Make sure to save it. Do not use the`/keys` command again unless you lose your key, as it will generate a new key pair.",
            color=discord.Color.pink(),
            timestamp=datetime.now()
        )
        priv_embed.add_field(name="Private Key", value=f"```{private_pem}```", inline=False)
        try:
            await interaction.user.send(embed=priv_embed)
            await interaction.followup.send("Success, your private key has been forwarded to your DMs.", ephemeral=True)
        except discord.Forbidden:
            await interaction.followup.send(embed=priv_embed, ephemeral=True)
        except Exception as e:
            await interaction.followup.send("An error occurred, please try again later.", ephemeral=True)
            logger.warning(f"Error in key generation: {e}")


async def setup(bot: commands.Bot):
    """
    Command setup.
    Args:
        bot: The bot.
    """
    await bot.add_cog(Keys(bot))
